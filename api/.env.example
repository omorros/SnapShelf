# Copy to api/.env and fill in.

# Postgres for real use; sqlite:///./snapshelf.db works for a quick local try.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/snapshelf

# Any long random string. Signs login tokens.
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Needed for photo scanning and recipe ideas.
OPENAI_API_KEY=sk-...
# The research picked GPT-5.2; any OpenAI vision model works.
OPENAI_VISION_MODEL=gpt-5.2

# Set to 1 to log every SQL statement.
SQL_ECHO=0
